---
/** Embeddable widget: no site chrome, noindex, frameable (see .htaccess), with a "Powered by Calcrafty" backlink. */
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { calculators, calcPath, resolvedDefaults } from '../../lib/registry.ts';
import { getWidget } from '../../lib/widgets.ts';

export const getStaticPaths = (() => calculators.map((c) => ({ params: { slug: c.slug }, props: { slug: c.slug } }))) satisfies GetStaticPaths;

const config = calculators.find((c) => c.slug === Astro.props.slug)!;
const Widget = getWidget(config.slug);
const path = calcPath(config);
const props = { initial: resolvedDefaults(config), path, embed: true };
const desc = `Embeddable ${config.name} from Calcrafty. ${config.metaDescription}`.slice(0, 157).replace(/\s+\S*$/, '') + '…';
---

<BaseLayout title={`${config.name} (embed) | Calcrafty`} description={desc.length >= 140 ? desc : config.metaDescription} path={`/embed/${config.slug}/`} noindex bare>
  <h1 class="sr-only">{config.name}</h1>
  <div data-widget={config.slug} data-props={JSON.stringify(props)}>
    <Widget {...props} />
  </div>
  <p class="mt-3 text-sm muted">
    Powered by <a href={`https://calcrafty.com${path}`} target="_blank" rel="noopener">Calcrafty {config.name}</a>
  </p>
  <script>
    import '../../scripts/islands-boot.ts';
  </script>
</BaseLayout>
