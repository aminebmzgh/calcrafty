---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories, categoryOrder } from '../lib/categories.ts';
---

<BaseLayout
  title="Page not found | Calcrafty"
  description="This page doesn't exist on Calcrafty. Search for a calculator or browse finance, health, math and everyday calculators from the links on this page instead."
  path="/404.html"
  noindex
>
  <section class="wrap py-16">
    <h1>This page doesn’t exist</h1>
    <p class="mt-3 max-w-xl text-lg muted">The link may be old or mistyped. Search for the calculator you need, or start from a category.</p>
    <p class="mt-6">
      <a href="/search/" class="btn btn-primary">Search calculators</a>
    </p>
    <ul class="mt-8 flex flex-wrap gap-2">
      {
        categoryOrder.map((id) => (
          <li>
            <a class="chip" href={`/${id}/`}>
              {categories[id].h1}
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>
