---
import ProseLayout from '../../layouts/ProseLayout.astro';
import { getCollection } from 'astro:content';

const guides = (await getCollection('guides')).sort((a, b) => a.data.title.localeCompare(b.data.title));
---

<ProseLayout
  title="Guides: Money, Health and Math Explained | Calcrafty"
  description="Calcrafty guides answer the big questions behind the calculators, from how much house you can afford to how many calories to eat, with worked examples."
  path="/guides/"
  h1="Guides"
  intro="The big questions behind the calculators, answered with real numbers."
>
  {guides.length === 0 && <p>Guides are on the way. In the meantime, every calculator page explains its formula and gives a worked example.</p>}
  <ul>
    {
      guides.map((g) => (
        <li>
          <a href={`/guides/${g.id}/`}>{g.data.title}</a>: {g.data.intro}
        </li>
      ))
    }
  </ul>
</ProseLayout>
