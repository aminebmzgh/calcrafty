---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/seo/Breadcrumbs.astro';
import { breadcrumbList, type JsonLdNode } from '../lib/schema.ts';
import { longDate } from '../lib/format.ts';

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  intro?: string;
  updated?: string;
  jsonLd?: JsonLdNode[];
}

const { title, description, path, h1, intro, updated, jsonLd = [] } = Astro.props;
const crumbs = [
  { name: 'Home', path: '/' },
  { name: h1, path },
];
---

<BaseLayout title={title} description={description} path={path} jsonLd={[breadcrumbList(crumbs), ...jsonLd]}>
  <article class="wrap py-8">
    <Breadcrumbs crumbs={crumbs} />
    <h1 class="mt-4">{h1}</h1>
    {intro && <p class="mt-3 max-w-2xl text-lg muted">{intro}</p>}
    {updated && <p class="mt-2 text-sm muted">Last updated {longDate(updated)}</p>}
    <div class="prose mt-8">
      <slot />
    </div>
  </article>
</BaseLayout>
