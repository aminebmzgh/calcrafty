---
import '../styles/global.css';
import SeoHead from '../components/seo/SeoHead.astro';
import JsonLd from '../components/seo/JsonLd.astro';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { organization, website, type JsonLdNode } from '../lib/schema.ts';
import { ANALYTICS_ID, ANALYTICS_SRC } from '../lib/site.ts';

interface Props {
  title: string;
  description: string;
  path: string;
  noindex?: boolean;
  ogImage?: string;
  type?: 'website' | 'article';
  jsonLd?: JsonLdNode[];
  /** Embed pages render without the site chrome. */
  bare?: boolean;
}

const { title, description, path, noindex, ogImage, type, jsonLd = [], bare = false } = Astro.props;
const nodes = [organization(), website(), ...jsonLd];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        let t;
        try {
          t = localStorage.getItem('calcrafty:theme');
        } catch {
          /* storage unavailable */
        }
        if (t !== 'dark' && t !== 'light') t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <SeoHead title={title} description={description} path={path} noindex={noindex} ogImage={ogImage} type={type} />
    <meta name="theme-color" content="#f6f8fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1424" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <JsonLd nodes={nodes} />
    {ANALYTICS_ID && <script is:inline defer src={ANALYTICS_SRC} data-website-id={ANALYTICS_ID} data-do-not-track="true" />}
  </head>
  <body class={bare ? 'calc-embed' : ''}>
    {
      !bare && (
        <a href="#main" class="skip-link">
          Skip to content
        </a>
      )
    }
    {!bare && <Header />}
    <main id="main" class={bare ? 'p-3' : 'flex-1'}>
      <slot />
    </main>
    {!bare && <Footer />}
    <script>
      import '../scripts/site.ts';
    </script>
  </body>
</html>
