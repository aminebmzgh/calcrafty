---
import Logo from './Logo.astro';
import { categories } from '../../lib/categories.ts';
import { liveCategories } from '../../lib/registry.ts';

const current = Astro.url.pathname.split('/')[1];
/** The first six live categories go in the bar; the rest sit under "More" so the header stays on one line. */
const PRIMARY = 6;
const primary = liveCategories.slice(0, PRIMARY);
const more = liveCategories.slice(PRIMARY);
const moreCurrent = more.some((id) => id === current);
---

<header class="border-b border-rule bg-surface">
  <div class="wrap flex min-h-16 flex-wrap items-center gap-x-3">
    <a href="/" class="mr-auto inline-flex min-h-11 items-center gap-2 text-ink no-underline" aria-label="Calcrafty home">
      <Logo />
      <span class="text-xl font-bold tracking-tight">Calcrafty</span>
    </a>
    <nav aria-label="Categories" class="order-last -mx-1 flex w-full items-center pb-2 md:order-none md:mx-0 md:w-auto md:pb-0">
      <ul class="flex min-w-0 flex-1 gap-1 overflow-x-auto">
        {
          primary.map((id) => (
            <li>
              <a
                href={`/${id}/`}
                class="inline-flex min-h-11 items-center whitespace-nowrap rounded-lg px-3 font-semibold text-ink no-underline hover:bg-surface-2"
                aria-current={current === id ? 'page' : undefined}
              >
                {categories[id].name}
              </a>
            </li>
          ))
        }
      </ul>
      {
        more.length > 0 && (
          <details class="nav-more relative shrink-0">
            <summary class={`inline-flex min-h-11 cursor-pointer items-center gap-1 rounded-lg px-3 font-semibold hover:bg-surface-2 ${moreCurrent ? 'text-accent' : 'text-ink'}`}>
              More
              <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </summary>
            <ul class="nav-more-panel absolute right-0 z-30 mt-1 grid min-w-48 gap-0.5 rounded-xl border border-rule bg-surface p-1.5 shadow-lg">
              {more.map((id) => (
                <li>
                  <a
                    href={`/${id}/`}
                    class="flex min-h-11 items-center rounded-lg px-3 font-semibold text-ink no-underline hover:bg-surface-2"
                    aria-current={current === id ? 'page' : undefined}
                  >
                    {categories[id].name}
                  </a>
                </li>
              ))}
            </ul>
          </details>
        )
      }
    </nav>
    <a href="/search/" class="btn btn-quiet" id="search-open" aria-keyshortcuts="/ Control+K Meta+K">
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <span>Search</span>
      <kbd class="hidden rounded border border-rule px-1.5 text-xs font-normal muted sm:inline">/</kbd>
    </a>
    <button type="button" class="btn btn-quiet" id="theme-toggle" aria-label="Switch to dark theme" title="Toggle dark mode">
      <svg class="theme-icon-sun" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
        <circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"></path>
      </svg>
      <svg class="theme-icon-moon" width="20" height="20" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">
        <path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"></path>
      </svg>
    </button>
  </div>
</header>

<script>
  // Progressive enhancement: close the "More" menu on Escape or a click outside it.
  const more = document.querySelector<HTMLDetailsElement>('details.nav-more');
  if (more) {
    document.addEventListener('click', (e) => {
      if (more.open && !more.contains(e.target as Node)) more.open = false;
    });
    more.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && more.open) {
        more.open = false;
        more.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  [aria-current='page'] {
    color: var(--accent);
  }
  .nav-more summary {
    list-style: none;
  }
  .nav-more summary::-webkit-details-marker {
    display: none;
  }
  .nav-more[open] summary svg {
    transform: rotate(180deg);
  }
  :global([data-theme='dark']) .theme-icon-sun,
  :global(:root:not([data-theme='dark'])) .theme-icon-moon {
    display: none;
  }
</style>
