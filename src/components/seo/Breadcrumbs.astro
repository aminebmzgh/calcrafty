---
import type { Crumb } from '../../lib/schema.ts';

interface Props {
  crumbs: Crumb[];
}

const { crumbs } = Astro.props;
---

<nav aria-label="Breadcrumb" class="text-sm muted no-print">
  <ol class="flex flex-wrap items-center gap-x-1.5 gap-y-1">
    {
      crumbs.map((c, i) => (
        <li class="flex items-center gap-1.5">
          {i > 0 && <span aria-hidden="true">›</span>}
          {i === crumbs.length - 1 ? (
            <span aria-current="page">{c.name}</span>
          ) : (
            <a href={c.path} class="inline-flex min-h-6 items-center">
              {c.name}
            </a>
          )}
        </li>
      ))
    }
  </ol>
</nav>
