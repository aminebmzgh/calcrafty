---
import { SITE } from '../../lib/site.ts';

interface Props {
  title: string;
  description: string;
  /** Root-relative path with trailing slash, e.g. /finance/mortgage-calculator/ */
  path: string;
  noindex?: boolean;
  /** Root-relative OG image path. */
  ogImage?: string;
  type?: 'website' | 'article';
}

const { title, description, path, noindex = false, ogImage = '/og/default.png', type = 'website' } = Astro.props;
// Canonical is always the clean, parameter-free URL.
const canonical = new URL(path, SITE.url).href;
const image = new URL(ogImage, SITE.url).href;
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
<meta property="og:site_name" content={SITE.name} />
<meta property="og:type" content={type} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={SITE.locale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />
