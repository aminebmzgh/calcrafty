{
  "name": "calcrafty",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lhci": "lhci autorun --config=lighthouserc.cjs && npm run build:ads && lhci autorun --config=lighthouserc.ads.cjs",
    "typecheck": "astro check",
    "lint": "eslint .",
    "seo:validate": "tsx scripts/validate-seo.ts",
    "keywords:check": "tsx scripts/check-keyword-map.ts",
    "links:check": "tsx scripts/check-links.ts",
    "uniqueness:check": "tsx scripts/check-uniqueness.ts",
    "check": "npm run typecheck && npm run lint && npm run keywords:check && npm run seo:validate && npm run links:check && npm run uniqueness:check && npm run budgets:check",
    "data:refresh": "tsx scripts/data-refresh.ts",
    "indexnow": "tsx scripts/indexnow.ts",
    "budgets:check": "tsx scripts/check-budgets.ts",
    "build:ads": "node scripts/build-ads.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.5",
    "@astrojs/mdx": "8.1.2",
    "@astrojs/preact": "6.1.1",
    "@preact/signals": "2.11.4",
    "astro": "7.4.4",
    "decimal.js-light": "2.5.1",
    "minisearch": "7.2.0",
    "preact": "11.1.1",
    "web-vitals": "6.2.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@fontsource/inter": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@tailwindcss/vite": "4.3.3",
    "eslint": "10.14.0",
    "eslint-plugin-astro": "3.2.1",
    "satori": "0.63.2",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
